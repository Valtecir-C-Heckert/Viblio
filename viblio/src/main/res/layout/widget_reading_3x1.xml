<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_editorial_bg"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_accent_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="9dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="9dp"
            android:background="#1A1A1A"
            android:contentDescription="Capa do livro atual"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_kicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="LENDO"
                    android:textColor="#C9A77C"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_brand_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:text="VIBLIO"
                    android:textColor="#8C877F"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Viblio"
                android:textColor="#F0ECE4"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/widget_progress_img"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:contentDescription="Progresso da leitura"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=""
                android:textColor="#8C877F"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
