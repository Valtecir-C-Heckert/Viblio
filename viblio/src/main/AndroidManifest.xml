<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <application android:icon="@drawable/viblio_launcher" android:roundIcon="@drawable/viblio_launcher" android:theme="@style/AppTheme" android:label="Viblio" android:usesCleartextTraffic="true" android:allowBackup="false" android:fullBackupContent="false" android:supportsRtl="true">
        <activity android:name="br.com.viblio.scanner.BarcodeScannerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name="br.com.viblio.ViblioActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viblio" android:host="current" />
            </intent-filter>
        </activity>

        <!-- 4 Home Screen Widget sizes (1x2, 2x2, 3x2, 4x2), all resizable -->
        <receiver android:name="br.com.viblio.widget.ViblioWidget1x2" android:label="Viblio · Capa (1×2)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_1x2_info" />
        </receiver>
        <receiver android:name="br.com.viblio.widget.ViblioWidget2x2" android:label="Viblio · Compacto (2×2)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_2x2_info" />
        </receiver>
        <receiver android:name="br.com.viblio.widget.ViblioWidget3x2" android:label="Viblio · Leitura (3×2)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_3x2_info" />
        </receiver>
        <receiver android:name="br.com.viblio.widget.ViblioWidget4x2" android:label="Viblio · Editorial (4×2)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_4x2_info" />
        </receiver>

        <!-- Optional local daily reading reminder -->
        <receiver android:name="br.com.viblio.reminder.ReadingReminderReceiver" android:exported="false" />

        <!-- Read-only share provider strictly scoped to cacheDir/wrapped/*.png -->
        <provider
            android:name="br.com.viblio.share.ViblioShareProvider"
            android:authorities="br.com.viblio.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
