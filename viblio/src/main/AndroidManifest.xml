    <application android:icon="@drawable/viblio_launcher" android:roundIcon="@drawable/viblio_launcher" android:theme="@style/AppTheme" android:label="Viblio" android:usesCleartextTraffic="true" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
