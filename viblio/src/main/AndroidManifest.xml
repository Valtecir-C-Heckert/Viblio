<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <application android:icon="@drawable/viblio_launcher" android:roundIcon="@drawable/viblio_launcher" android:theme="@style/AppTheme" android:label="Viblio" android:usesCleartextTraffic="true" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name="br.com.viblio.scanner.BarcodeScannerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name="br.com.viblio.ViblioActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viblio" android:host="current" />
            </intent-filter>
        </activity>

        <!-- 5 Home Screen Widget sizes (1x1, 2x1, 3x1, 4x1, 5x1), compact 1-row & resizable -->
        <receiver android:name="br.com.viblio.widget.ViblioWidget1x1" android:label="Viblio · Capa (1×1)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_1x1_info" />
        </receiver>
        <receiver android:name="br.com.viblio.widget.ViblioWidget2x1" android:label="Viblio · Compacto (2×1)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_2x1_info" />
        </receiver>
        <receiver android:name="br.com.viblio.widget.ViblioWidget3x1" android:label="Viblio · Leitura (3×1)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_3x1_info" />
        </receiver>
        <receiver android:name="br.com.viblio.widget.ViblioWidget4x1" android:label="Viblio · Editorial (4×1)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_4x1_info" />
        </receiver>
        <receiver android:name="br.com.viblio.widget.ViblioWidget5x1" android:label="Viblio · Largo (5×1)" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/viblio_widget_5x1_info" />
        </receiver>

        <!-- Optional local daily reading reminder -->
        <receiver android:name="br.com.viblio.reminder.ReadingReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Read-only share provider strictly scoped to cacheDir/wrapped/*.png -->
        <provider
            android:name="br.com.viblio.share.ViblioShareProvider"
            android:authorities="br.com.viblio.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
